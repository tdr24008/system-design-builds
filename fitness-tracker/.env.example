# Copy to .env and adjust values
DATABASE_URL=postgresql+asyncpg://pulse:pulse@localhost:5432/pulse
REDIS_URL=redis://localhost:6379
BLOB_DIR=./data/blobs

# Fan-out threshold: authors with more than this many followers
# use pull-on-read instead of push fan-out
FANOUT_THRESHOLD=10000

# Comma-separated list of allowed frontend origins (JSON array format)
# In production set to your deployed frontend URL, e.g.:
# CORS_ORIGINS=["https://your-frontend.up.railway.app"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
